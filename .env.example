# sighop configuration (DESIGN.md §10, milestone 5 design D9).
#
# Copy to .env.dev — which is gitignored — and fill in real values. Nothing
# reads this file automatically: `uv run --env-file .env.dev sighop run …`
# loads it, and a container takes its environment from compose (see below).
# There is deliberately no dotenv dependency and no default for either value.

# Where the database is. The driver must be postgresql+asyncpg: sighop carries
# one driver (DESIGN.md §2) and Alembic bridges to it through an async env.py.
# libpq-only query parameters (?sslmode=, ?options=) are refused at startup —
# asyncpg does not read them, and passing one through would connect without the
# TLS it looks like it asked for.
#
# Leave it unset to run entirely in memory: contacts, paths and the packet log
# then live only for the process, which is what sighop did before milestone 5.
DATABASE_URL=postgresql+asyncpg://role:password@host:5432/database

# The key entity seeds are sealed under, base64 of exactly 32 bytes. Generate
# one with:
#
#     sighop keys secret
#
# It is never padded, truncated or hashed into shape, is never written to the
# database, and losing it makes every stored identity unrecoverable — that is
# what encryption at rest means. `sighop keys export` is how an identity is
# backed up deliberately.
SIGHOP_SECRET_KEY=

# --- The compose deployment (milestone 9) ------------------------------------
#
# compose.yaml reads ./.env (gitignored). It builds DATABASE_URL itself from
# POSTGRES_PASSWORD, so keep that password URL-safe (e.g. openssl rand -hex 24),
# and takes SIGHOP_SECRET_KEY as above.
#
# UID=1000
# GID=1000
# DIALOUT_GID=984            # stat -c %g /dev/serial/by-id/usb-...
# SIGHOP_MODEM=/dev/serial/by-id/usb-...
# POSTGRES_PASSWORD=
