# sighop configuration (DESIGN.md §10, milestone 5 design D9).
#
# Copy to .env.dev — which is gitignored — and fill in real values. Nothing
# reads this file automatically: `uv run --env-file .env.dev sighop run …`
# loads it, and a container takes its environment from compose (see below).
# There is deliberately no dotenv dependency and no default for either value.

# Where the database is. The driver must be postgresql+asyncpg: sighop carries
# one driver (DESIGN.md §2) and Alembic bridges to it through an async env.py.
# libpq-only query parameters (?sslmode=, ?options=) are refused at startup —
# asyncpg does not read them, and passing one through would connect without the
# TLS it looks like it asked for.
#
# Leave it unset to run entirely in memory: contacts, paths and the packet log
# then live only for the process, which is what sighop did before milestone 5.
DATABASE_URL=postgresql+asyncpg://role:password@host:5432/database

# The key entity seeds are sealed under, base64 of exactly 32 bytes. Generate
# one with:
#
#     sighop keys secret
#
# It is never padded, truncated or hashed into shape, is never written to the
# database, and losing it makes every stored identity unrecoverable — that is
# what encryption at rest means. `sighop keys export` is how an identity is
# backed up deliberately.
SIGHOP_SECRET_KEY=

# Bytes per hop hash on every packet this node originates with an empty path —
# floods and zero-hop adverts, channel posts, flooded direct messages and their
# acknowledgements, room PATH returns. Repeaters append their own hash at this
# width, so 1 collides at 1 in 256. Accepts 1, 2 or 3; unset or empty is 3. Any
# other value fails `sighop run` at startup. Routes learned from the mesh keep the
# width they were learned at. Set it to 1 for the behaviour before this setting
# existed, e.g. on a mesh whose repeaters predate multi-byte paths.
# SIGHOP_PATH_HASH_SIZE=3

# --- The compose deployment ---------------------------------------------------
#
# compose.yaml is the same file on every host, development and production; what
# differs between hosts lives in that host's ./.env (gitignored), which compose
# reads by itself. The database is always external — compose runs no postgres.
#
# Required in ./.env — compose refuses to start and names any that is unset:
#
# UID=1000
# GID=1000
# DIALOUT_GID=984            # stat -c %g /dev/serial/by-id/usb-...
# SIGHOP_MODEM=/dev/serial/by-id/usb-...
# DATABASE_URL=              # as above; the host's own database
# SIGHOP_SECRET_KEY=         # as above; the key that database's identities are sealed under
#
# Compose interpolates ./.env, so single-quote a DATABASE_URL whose password
# contains a `$` (the password must already be URL-encoded). A dev host keeps
# DATABASE_URL and SIGHOP_SECRET_KEY in .env.dev for `uv run` as well; the same
# two lines go in ./.env, or make ./.env a superset and `uv run --env-file .env`.
# A key that did not seal the database's identities cannot unseal them, so each
# database keeps its own key.
#
# Optional:
#
# SIGHOP_IMAGE=sighop:local  # e.g. a published ghcr.io tag in production
# SIGHOP_WEB_BIND=127.0.0.1  # host address the panel is published on; an IPv6
#                            # address goes in brackets, e.g. [::1]
# SIGHOP_WEB_PORT=8080       # host port; localhost and 127.0.0.1 on it are allowed
# SIGHOP_WEB_ALLOWED_HOST=   # one more NAME[:PORT] the panel answers to, e.g. the
#                            # name a reverse proxy forwards as its Host header
# SIGHOP_PATH_HASH_SIZE=     # 1, 2 or 3 (as above); unset is 3
# COMPOSE_PROJECT_NAME=      # default: the checkout's directory name
#
# The panel is plain HTTP. A SIGHOP_WEB_BIND other than loopback sends passwords
# and session cookies over the network unencrypted — put a TLS proxy in front and
# name it in SIGHOP_WEB_ALLOWED_HOST instead.
