# sighop configuration (DESIGN.md §10, milestone 5 design D9).
#
# Copy to .env.dev — which is gitignored — and fill in real values. Nothing
# reads this file automatically: `uv run --env-file .env.dev sighop` loads it,
# and a container takes its environment from compose (see below). There is
# deliberately no dotenv dependency.
#
# The environment is sighop's only configuration surface. `sighop` takes no
# arguments, and at startup it reports every problem with these variables at
# once — naming each — before it opens the modem or the database.

# Where the database is. Required: sighop stores every identity, room, bot,
# channel, message and account there, and does not start without one. It
# applies outstanding migrations to it every time it starts. The driver must be
# postgresql+asyncpg: sighop carries one driver (DESIGN.md §2) and Alembic
# bridges to it through an async env.py. libpq-only query parameters (?sslmode=,
# ?options=) are refused at startup — asyncpg does not read them, and passing
# one through would connect without the TLS it looks like it asked for.
#
# The test suite needs one too: SIGHOP_TEST_DATABASE_URL, or this. Each run
# works in a schema of its own inside it and drops that schema afterwards.
DATABASE_URL=postgresql+asyncpg://role:password@host:5432/database

# The key entity seeds are sealed under, base64 of exactly 32 bytes. Required.
# Generate one with:
#
#     openssl rand -base64 32
#
# It is never padded, truncated or hashed into shape, is never written to the
# database, and losing it makes every stored identity unrecoverable — that is
# what encryption at rest means. Exporting an identity from the panel is how
# one is backed up deliberately.
SIGHOP_SECRET_KEY=

# Bytes per hop hash on every packet this node originates with an empty path —
# floods and zero-hop adverts, channel posts, flooded direct messages and their
# acknowledgements, room PATH returns. Repeaters append their own hash at this
# width, so 1 collides at 1 in 256. Accepts 1, 2 or 3; unset or empty is 3. Any
# other value fails startup. Routes learned from the mesh keep the
# width they were learned at. Set it to 1 for the behaviour before this setting
# existed, e.g. on a mesh whose repeaters predate multi-byte paths.
# SIGHOP_PATH_HASH_SIZE=3

# --- The node ------------------------------------------------------------------
#
# Every setting that used to be a `sighop run` flag, now read only from here.
# Each shows its default; the flag it replaces is in brackets.

# The modem's stable device path. Required outside compose (compose sets it to
# /dev/modem inside the container). [--device]
# SIGHOP_MODEM=/dev/serial/by-id/usb-...

# Radio parameters applied via SetRadio at the probe. [--radio-preset]
# SIGHOP_RADIO_PRESET=eu868-narrow

# Open the transmit gate at startup. Without it nothing is transmitted: packets
# are scheduled, charged against the duty-cycle budget and logged, then dropped
# at the hand-off to the modem. The panel can open the gate at run time too.
# 1/true/yes/on or 0/false/no/off. [--enable-transmit]
# SIGHOP_ENABLE_TRANSMIT=false

# Fraction of an hour sighop may transmit for — a fraction, not a percentage:
# 0.10 is the EU 868 limit, and a value above 1 is refused. [--duty-cycle-ceiling]
# SIGHOP_DUTY_CYCLE_CEILING=0.10

# Seconds between status lines. [--status-interval]
# SIGHOP_STATUS_INTERVAL=60

# Duplicate cache time-to-live in seconds, and its entry cap.
# [--dedup-ttl, --dedup-max-entries]
# SIGHOP_DEDUP_TTL=300
# SIGHOP_DEDUP_MAX_ENTRIES=4096

# Also write received and transmitted frames to this capture file (JSONL).
# Unset writes none. [--capture]
# SIGHOP_CAPTURE_FILE=

# Also append wide-event logs to this file; they always go to standard error.
# Unset writes none. [--log-file]
# SIGHOP_LOG_FILE=

# The web interface is always served. Its listening address, port, and any
# further host names it answers to, comma-separated — an environment variable
# cannot repeat as a flag could. A non-loopback address is announced at startup
# as reachable over plain HTTP. [--web-host, --web-port, --web-allowed-host]
# SIGHOP_WEB_HOST=127.0.0.1
# SIGHOP_WEB_PORT=8080
# SIGHOP_WEB_ALLOWED_HOSTS=

# Gone, with no replacement: --stub, --entity, --peer, --send, --allow-flood,
# --advert-zero-hop, --peer-wait, --advert-override-seconds,
# --advert-override-expires-in, --replay, --persist-replay, --migrate (starting
# always migrates), --database-url (DATABASE_URL is the only source) and --web
# (the interface is always served). Identities held only as keyfiles must be
# imported through the panel.

# --- The compose deployment ---------------------------------------------------
#
# compose.yaml is the same file on every host, development and production; what
# differs between hosts lives in that host's ./.env (gitignored), which compose
# reads by itself. The database is always external — compose runs no postgres.
#
# Required in ./.env — compose refuses to start and names any that is unset:
#
# UID=1000
# GID=1000
# DIALOUT_GID=984            # stat -c %g /dev/serial/by-id/usb-...
# SIGHOP_MODEM=/dev/serial/by-id/usb-...
# DATABASE_URL=              # as above; the host's own database
# SIGHOP_SECRET_KEY=         # as above; the key that database's identities are sealed under
#
# Compose interpolates ./.env, so single-quote a DATABASE_URL whose password
# contains a `$` (the password must already be URL-encoded). A dev host keeps
# DATABASE_URL and SIGHOP_SECRET_KEY in .env.dev for `uv run` as well; the same
# two lines go in ./.env, or make ./.env a superset and `uv run --env-file .env`.
# A key that did not seal the database's identities cannot unseal them, so each
# database keeps its own key.
#
# Optional:
#
# SIGHOP_IMAGE=sighop:local  # e.g. a published ghcr.io tag in production
# SIGHOP_WEB_BIND=127.0.0.1  # host address the panel is published on; an IPv6
#                            # address goes in brackets, e.g. [::1]
# SIGHOP_WEB_PORT=8080       # host port; localhost and 127.0.0.1 on it are allowed
# SIGHOP_WEB_ALLOWED_HOST=   # one more NAME[:PORT] the panel answers to, e.g. the
#                            # name a reverse proxy forwards as its Host header
# SIGHOP_PATH_HASH_SIZE=     # 1, 2 or 3 (as above); unset is 3
# COMPOSE_PROJECT_NAME=      # default: the checkout's directory name
#
# The panel is plain HTTP. A SIGHOP_WEB_BIND other than loopback sends passwords
# and session cookies over the network unencrypted — put a TLS proxy in front and
# name it in SIGHOP_WEB_ALLOWED_HOST instead.
